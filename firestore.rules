rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rutas: lectura pública (cualquiera con la app puede consultarlas),
    // escritura solo desde el Admin SDK (script de importación), nunca desde el cliente.
    match /routes/{routeId} {
      allow read: if true;
      allow write: if false;
    }

    // Paradas: mismo criterio que rutas.
    match /stations/{stationId} {
      allow read: if true;
      allow write: if false;
    }

    // Usuarios: cada quien lee/escribe SOLO su propio documento.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Favoritos: subcolección dentro del propio usuario, mismo criterio.
      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}